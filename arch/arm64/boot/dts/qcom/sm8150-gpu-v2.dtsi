&soc {
	gpu_opp_table_v2: gpu_opp_table_v2 {
		compatible = "operating-points-v2";

		opp-770000000 {
			opp-hz = /bits/ 64 <770000000>;
			opp-microvolt = <321>;
		};

		opp-715000000 {
			opp-hz = /bits/ 64 <715000000>;
			opp-microvolt = <257>;
		};

		opp-692000000 {
			opp-hz = /bits/ 64 <692000000>;
			opp-microvolt = <225>;
		};

		opp-615000000 {
			opp-hz = /bits/ 64 <615000000>;
			opp-microvolt = <193>;
		};

		opp-515000000 {
			opp-hz = /bits/ 64 <515000000>;
			opp-microvolt = <129>;
		};

		opp-427000000 {
			opp-hz = /bits/ 64 <427000000>;
			opp-microvolt = <65>;
		};

		opp-340000000 {
			opp-hz = /bits/ 64 <340000000>;
			opp-microvolt = <40>;
		};
	};
};
